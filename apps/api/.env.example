# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/grocgo?schema=public"

# JWT
JWT_SECRET="grocgo-dev-secret-change-in-production"
JWT_EXPIRES_IN="7d"

# Server
PORT=4000
NODE_ENV=development

# Frontend URL (for CORS)
FRONTEND_URL="http://localhost:3000"

# WhatsApp API (modular — set your provider)
WHATSAPP_PROVIDER="none"
WHATSAPP_API_URL=""
WHATSAPP_API_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""

# OCR
OCR_ENABLED=true
